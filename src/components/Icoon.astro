---
// Kleine lijniconen (gebaseerd op Lucide, MIT licentie), zie lib/iconen.mjs.
import { ICONEN as BRON_ICONEN } from '../lib/iconen.mjs';
interface Props {
  naam: string;
  grootte?: number;
  class?: string;
  label?: string;
}
const { naam, grootte = 20, class: klasse, label } = Astro.props;

const ICONEN: Record<string, string> = BRON_ICONEN;
const pad = ICONEN[naam] ?? ICONEN.file;
---

<svg
  class:list={['icoon', klasse]}
  width={grootte}
  height={grootte}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  set:html={pad}
/>
