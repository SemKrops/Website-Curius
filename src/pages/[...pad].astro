---
// Elke pagina van de site: dezelfde adressen als op de oude site, zodat oude
// links (en QR codes op posters) blijven werken.
import ActiviteitPagina from '../components/ActiviteitPagina.astro';
import Home from '../components/Home.astro';
import InhoudPagina from '../components/InhoudPagina.astro';
import { mijnCuriusPagina } from '../lib/mijncurius.mjs';
import { haalSite } from '../lib/site.mjs';

export async function getStaticPaths() {
  const site = await haalSite();
  // Het fotoalbum en Mijn Curius maakt [taal]/[...mijn].astro.
  return Object.keys(site.paginas)
    .filter((pad) => !mijnCuriusPagina(pad))
    .map((pad) => ({ params: { pad }, props: { pad } }));
}

const site = await haalSite();
const pagina = site.paginas[Astro.props.pad];
---

{
  pagina.soort === 'home' ? (
    <Home site={site} pagina={pagina} />
  ) : pagina.soort === 'activiteit' ? (
    <ActiviteitPagina site={site} pagina={pagina} />
  ) : (
    <InhoudPagina site={site} pagina={pagina} />
  )
}
